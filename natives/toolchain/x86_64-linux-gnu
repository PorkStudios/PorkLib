export CC		:= x86_64-linux-gnu-gcc
export CXX		:= x86_64-linux-gnu-g++
export LD		:= x86_64-linux-gnu-g++

export EXT	:=	so

export CFLAGS   += $(GLOBAL_FLAGS_COMMON) $(GLOBAL_FLAGS_GNUC) $(GLOBAL_FLAGS_LINUX)
export CFLAGS   += $(COMPILE_FLAGS_COMMON) $(COMPILE_FLAGS_GNUC) $(COMPILE_FLAGS_LINUX)
export CFLAGS   += $(COMPILE_CFLAGS_COMMON) $(COMPILE_CFLAGS_GNUC) $(COMPILE_CFLAGS_LINUX)

export CXXFLAGS += $(GLOBAL_FLAGS_COMMON) $(GLOBAL_FLAGS_GNUC) $(GLOBAL_FLAGS_LINUX)
export CXXFLAGS += $(COMPILE_FLAGS_COMMON) $(COMPILE_FLAGS_GNUC) $(COMPILE_FLAGS_LINUX)
export CXXFLAGS += $(COMPILE_CXXFLAGS_COMMON) $(COMPILE_CXXFLAGS_GNUC) $(COMPILE_CXXFLAGS_LINUX)

export LDFLAGS  += $(GLOBAL_FLAGS_COMMON) $(GLOBAL_FLAGS_GNUC) $(GLOBAL_FLAGS_LINUX)
export LDFLAGS  += $(COMPILE_FLAGS_COMMON) $(COMPILE_FLAGS_GNUC) $(COMPILE_FLAGS_LINUX)
export LDFLAGS  += $(LDFLAGS_COMMON) $(LDFLAGS_GNUC) $(LDFLAGS_LINUX)
