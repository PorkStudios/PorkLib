export CC		:= clang-msvc-x86 --target=i386-pc-windows
export CXX		:= clang++-msvc-x86 --target=i386-pc-windows
export LD		:= clang++-msvc-x86 --target=i386-pc-windows

export EXT	:=	dll

export CFLAGS   += $(GLOBAL_FLAGS_COMMON) $(GLOBAL_FLAGS_CLANG) $(GLOBAL_FLAGS_WINDOWS)
export CFLAGS   += $(COMPILE_FLAGS_COMMON) $(COMPILE_FLAGS_CLANG) $(COMPILE_FLAGS_WINDOWS)
export CFLAGS   += $(COMPILE_CFLAGS_COMMON) $(COMPILE_CFLAGS_CLANG) $(COMPILE_CFLAGS_WINDOWS)

export CXXFLAGS += $(GLOBAL_FLAGS_COMMON) $(GLOBAL_FLAGS_CLANG) $(GLOBAL_FLAGS_WINDOWS)
export CXXFLAGS += $(COMPILE_FLAGS_COMMON) $(COMPILE_FLAGS_CLANG) $(COMPILE_FLAGS_WINDOWS)
export CXXFLAGS += $(COMPILE_CXXFLAGS_COMMON) $(COMPILE_CXXFLAGS_CLANG) $(COMPILE_CXXFLAGS_WINDOWS)

export LDFLAGS  += $(GLOBAL_FLAGS_COMMON) $(GLOBAL_FLAGS_CLANG) $(GLOBAL_FLAGS_WINDOWS)
export LDFLAGS  += $(COMPILE_FLAGS_COMMON) $(COMPILE_FLAGS_CLANG) $(COMPILE_FLAGS_WINDOWS)
export LDFLAGS  += $(LDFLAGS_COMMON) $(LDFLAGS_CLANG) $(LDFLAGS_WINDOWS)
